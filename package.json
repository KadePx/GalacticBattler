{
  "name": "galactic-battler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "feedback": "npx wrangler d1 execute galactic-ghosts --remote --command \"SELECT id, datetime(created/1000,'unixepoch') AS at, kind, name, text, context FROM feedback ORDER BY id DESC LIMIT 50\"",
    "balance": "esbuild src/dev/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/balance.mjs --log-level=warning && node node_modules/.cache/balance.mjs",
    "world": "esbuild src/commonworld/dev/runner.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/world.mjs --log-level=warning && node node_modules/.cache/world.mjs",
    "world:host": "esbuild src/commonworld/dev/hostTest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hosttest.mjs --log-level=warning && node node_modules/.cache/hosttest.mjs",
    "world:admin": "node scripts/cwAdmin.mjs",
    "hl": "esbuild src/hollowlands/dev/runner.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hl.mjs --log-level=warning && node node_modules/.cache/hl.mjs",
    "hl:host": "esbuild src/hollowlands/dev/hostTest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hlhost.mjs --log-level=warning && node node_modules/.cache/hlhost.mjs",
    "hl:admin": "node scripts/hlAdmin.mjs",
    "hl:sweep": "esbuild src/hollowlands/dev/sweep.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hlsweep.mjs --log-level=warning && node node_modules/.cache/hlsweep.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "pixi.js": "8.21.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
